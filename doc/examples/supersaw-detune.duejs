// Supersaw y detune inspirados en S01-S02: pulso compacto, bajo ancho y arpegio brillante.
bpm(124)

// Bombo a negras y hats sincopados
sam1#kick(C2;0.12b;1b):v(48)
sam2#hats([C4>~>C4>C4>~>C4>C4>~];0.08b;0.5b):v(36)

// Bajo supersaw: detune leve para engordar sin emborronar el grave
n1#supersaw([C2>~>C2>G2>~>C2>~>D#2];0.18b;0.5b):v(42)::detune(4)

// Arpegio en pentatonica menor con variacion de afinacion mas audible
n2#supersaw([C4>G4>D#4>G4>Bb4>G4>D#4>G4];0.1b;0.25b):v(38)::detune(12)

// Acordes de piano espaciados para dar profundidad al sintetizador
sam3#piano([C4|D#4|G4|Bb4];1.5;4b):r(80):d(60;0.35):v(26)