// .#####..##..##.######........######..####..
// .##..##.##..##.##................##.##.....
// .##..##.##..##.####..............##..####..
// .##..##.##..##.##.......##...##..##.....##.
// .#####...####..######...##....####...####..
// Aproximacion a una sesion trance de DJ_Dave (#algorave): bombo a negras, acordes apilados, arpegio y trozos de voz.
// En do menor. Cada pista queda en su propia linea para comentarla (//) y hacer el break.
bpm(130)

// Bateria: bombo en cada pulso, hi-hat a contratiempo y caja cada dos pulsos
sam1#kick(C2;0.25b;1b):v(-1)
sam2#hats(C4;0.1b;[0.5b,1b]):r(2):v(-3)
sam3#snare(C3;0.25b;2b):r(10):v(-2)

// Bajo: nota corta grave que sigue la progresion, en secuencia
n1([C2>C2>G#1>G#1>A#1>A#1>F2>G2];0.4b;0.5b)::human(0.01)

// Acordes largos con octavas apiladas, una progresion de cuatro acordes
sam4#piano([C3|D#3|G3>G#2|C3|D#3>F3|G#3|C4>A#2|D3|F3];4b;4b):r(40):d(64;0.5)::chord(0.6)

// Arpegio rapido en pentatonica de do menor: saltos cortos, sin repetir enseguida
n2([C4,D#4,F4,G4,A#4,C5];0.2b;0.25b)::walk(4)::unique(0.4)::oct(0.15;1)::human(0.01)

// Trozos de voz: notas sueltas del acorde, retrasadas y sin repetir
sam5#chorus([C4,D#4,G4,A#4];0.5b;[0.5b-1b]):r(60)::unique(2)::late(0.3;0.1)::human(0.02)
