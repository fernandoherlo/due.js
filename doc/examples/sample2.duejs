// .#####..##..##.######........######..####..
// .##..##.##..##.##................##.##.....
// .##..##.##..##.####..............##..####..
// .##..##.##..##.##.......##...##..##.....##.
// .#####...####..######...##....####...####..
// sample 2: tempo, pulsos (b), modo reverse, acordes y capas ritmicas

bpm(90) // tempo de la sesion; sin sufijo los valores siguen siendo segundos

$low=-1
$xlow=-3
$high=5
$beat=1b
$bar=4b

// $$test=mi0(1@5)
$$test=mi0(1@5) // midiIn, input0, canal 1, controlador CC 5
// n1(A3;0.5;1):v($$test)

// mo1#1([C3>G3>E3>C3>G3>E3];8;8)

// pulso base, sincronizado con bpm
sam1#kick(C2;0.25b;$beat):v($low)
sam2#hats(C4;0.1b;[0.5b,1b]):r(2):v($xlow)

// capas lentas en segundos, como en el sample 1
sam3#tom([A2>C2>B2>D3];[1-3];[11-18]):r(20):d(0.8):v($low)
sam4#tom([A5,C5,B5,D4,F5];[0.2-1];[16-22]):r(2):d(0.6):v($high)
sam5#harp([G4,E4,C4,A3,F4,C5,A4];7;[6-17]):r(7):v($high)
sam6#birds([A3,C2,F5];1;[4-6]):v($xlow)
sam7#piano([A2|C2|B2,D2|A2|G2];[7-8];[8-10]):r(17):d(0.2):v($low)
sam8#cor([D3>A2>D#2>G3>B3>F#2>C3>F#2>F2>A#2>A2>D1>E2];[3-8];[4,7,10,12,15]):r(17):d(0.3):v($xlow)

// acordes que respiran con el tempo; reverse invierte la mitad de las veces
sam9#glock([C5|E5|G5,D5|F5|A5];$beat;[2b-4b])::reverse(64):r(10):v($low)

// arpegio que siempre suena hacia atras, con eco sincronizado al compas
sam10#piano([C3>E3>G3>B3];2b;$bar)::reverse(127):d(64;0.4):v($low)

// colchon largo en pulsos
sam11#bowls([A2|E3,D2|A2];8b;[8b-16b]):r(30):v($xlow)

// motivo corto con chorus y reverse ocasional
sam12#marimba([C4>E4>G4>E4];0.5b;0.5b)::reverse(32):cho(10):v($xlow)

ai1#trombbone(;;[1,12]):v($high)
